{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!output",
      "!apps/account-worker/worker-configuration.d.ts",
      "!dist",
      "!dist-electron",
      "!dist-web",
      "!release",
      "!generated",
      "!runtime",
      "!.wrangler",
      "!.venv-layout",
      "!coverage",
      "!.omo",
      "!.omc",
      "!.omx",
      "!.codegraph",
      "!.claude",
      "!.omo/evidence",
      "!test-results",
      "!playwright-report",
      "!recording-review-*",
      "!promo/out",
      "!promo/public/frames",
      "!promo/public/timeline-*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "useImportType": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      }
    }
  }
}
