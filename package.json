{
  "name": "scourgify",
  "version": "1.0.0",
  "private": false,
  "description": "A local-first spatial PDF reading board",
  "license": "MIT",
  "author": "heonyus",
  "homepage": "https://github.com/heonyus/scourgify#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/heonyus/scourgify.git"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npx wait-on tcp:5173 && electron .\"",
    "build": "node scripts/build-electron.mjs && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "package": "npm run build && electron-builder --dir",
    "make": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --x64 --arm64",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64",
    "fixture": "tsx scripts/create-fixture.ts",
    "setup:layout": "node scripts/setup-layout-runtime.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "verify:installed-layout": "node scripts/verify-installed-layout.mjs"
  },
  "build": {
    "appId": "com.honey.scourgify",
    "productName": "Scourgify",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "build/scourgify.icns",
      "target": [
        "dir",
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "extraMetadata": {
      "main": "dist-electron/electron/main.js"
    },
    "extraResources": [
      {
        "from": "src/layout/pp_structure_layout.py",
        "to": "layout/pp_structure_layout.py"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "heonyus",
      "repo": "scourgify"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "katex": "^0.18.4",
    "lucide-react": "^0.542.0",
    "openai": "^7.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "undici": "^6.28.0",
    "zod": "^4.1.5"
  }
}
