{
  "name": "oh-my-paper",
  "version": "2.1.0",
  "private": true,
  "description": "A local-first spatial PDF reading board",
  "license": "MIT",
  "author": {
    "name": "heonyus",
    "email": "108461006+heonyus@users.noreply.github.com",
    "url": "https://github.com/heonyus"
  },
  "homepage": "https://github.com/heonyus/scourgify#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/heonyus/scourgify.git"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "dev:web": "concurrently \"tsx src/server/main.ts\" \"vite --config vite.web.config.ts --port 5173\"",
    "build:web": "vite build --config vite.web.config.ts",
    "start:web": "tsx src/server/main.ts",
    "build": "node scripts/build-electron.mjs && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "release:check": "node scripts/release-preflight.mjs --config-only",
    "release:preflight": "node scripts/release-preflight.mjs",
    "package": "npm run release:check && npm run build && electron-builder --dir --mac --arm64 --publish never",
    "make": "npm run release:check && npm run build && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:mac": "npm run release:check && npm run build && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:win": "node scripts/release-preflight.mjs --unsupported win32",
    "dist:linux": "node scripts/release-preflight.mjs --unsupported linux",
    "fixture": "tsx scripts/create-fixture.ts",
    "setup:layout": "node scripts/setup-layout-runtime.mjs",
    "setup:mineru": "node scripts/setup-mineru-runtime.mjs",
    "setup:paddle-vl": "node scripts/setup-paddle-vl-runtime.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "verify:installed-layout": "node scripts/verify-installed-layout.mjs"
  },
  "build": {
    "appId": "com.honey.oh-my-paper",
    "productName": "oh-my-paper",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "assets/branding/scourgify-leaf-mark.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "asar": true,
    "extraMetadata": {
      "main": "dist-electron/electron/main.js"
    },
    "extraResources": [
      {
        "from": "src/layout/pp_structure_layout.py",
        "to": "layout/pp_structure_layout.py"
      },
      {
        "from": "src/layout/pp_structure_enrichment.py",
        "to": "layout/pp_structure_enrichment.py"
      },
      {
        "from": "src/layout/paddle_vl_page_parser.py",
        "to": "layout/paddle_vl_page_parser.py"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "heonyus",
      "repo": "scourgify"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@cloudflare/workers-types": "5.20260910.1",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "better-auth": "1.7.4",
    "docx": "^9.7.1",
    "dotenv": "^16.6.1",
    "katex": "^0.18.4",
    "lucide-react": "^0.542.0",
    "openai": "^7.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "undici": "^6.28.0",
    "yaml": "^2.9.0",
    "zod": "^4.1.5"
  }
}
