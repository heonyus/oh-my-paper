{
  "name": "oh-my-paper-promo",
  "version": "0.0.0",
  "private": true,
  "description": "Remotion project for the oh-my-paper README video and in-app feature clips",
  "type": "module",
  "scripts": {
    "record": "node --experimental-strip-types record.ts",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Promo out/oh-my-paper.mp4",
    "render:clips": "node --experimental-strip-types render-clips.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.529"
  }
}
