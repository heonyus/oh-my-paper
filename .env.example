# Development only. Installed apps should use Settings > AI settings,
# which stores the key in Electron safeStorage/OS credential storage.
HOTEBOOK_AI_PROVIDER=openai
HOTEBOOK_AI_MODEL=gpt-5
OPENAI_API_KEY=

# OpenRouter alternative:
# HOTEBOOK_AI_PROVIDER=openrouter
# HOTEBOOK_AI_MODEL=openai/gpt-5
# OPENROUTER_API_KEY=
