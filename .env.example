# Development only. Installed apps should use Settings > AI settings,
# which stores the key in Electron safeStorage/OS credential storage.
SCOURGIFY_AI_PROVIDER=openrouter
SCOURGIFY_AI_MODEL=z-ai/glm-5.3-flash
OPENROUTER_API_KEY=
SCOURGIFY_LAYOUT_PYTHON=

# Other supported models:
# deepseek/deepseek-v4-flash-0731
# nvidia/nemotron-3-ultra-550b-a55b:free

# OpenAI alternative:
# SCOURGIFY_AI_PROVIDER=openai
# SCOURGIFY_AI_MODEL=gpt-5
# OPENAI_API_KEY=
