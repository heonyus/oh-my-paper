# Desktop account bindings only; all three are non-secret and intentionally blank.
# Copy to an uncommitted .env for source development. Main loads it via dotenv/config;
# inherited environment values take precedence. Packaged apps do not bundle .env.
# Missing/invalid bindings keep the app locked; there is no production guest/test bypass.

# Account API HTTPS origin: no path, trailing slash, query, fragment, or credentials.
SCOURGIFY_ACCOUNT_SERVICE_ORIGIN=

# Expected session issuer: exact HTTPS origin matching the backend APP_ISSUER.
SCOURGIFY_ACCOUNT_ISSUER=

# Google Desktop OAuth client ID accepted by the backend GOOGLE_CLIENT_IDS.
# This public client ID is not a client secret, app session, or AI credential.
SCOURGIFY_GOOGLE_CLIENT_ID=

# Backend DB/signing configuration belongs to apps/account-worker, never this file.
# Keep signing keys, tokens, and personal API keys out of this template.
# Configure separate AI connections in Settings; Google login does not grant AI access.
# Prerequisites and synthetic-only test boundaries: docs/account-service.md.

# Main-process document OCR. Use an uncommitted .env; never bundle the real key.
# Installed local app: ~/Library/Application Support/Scourgify/.env
MISTRAL_API_KEY=
